    },
    "./relation-web": "./src/relation-web.mjs",
    "./pam": "./src/pam.mjs",
    "./four-profile": "./src/four-profile.mjs",
    "./cell-moves": "./src/cell-moves.mjs",
    "./relation-adapters": "./src/relation-adapters.mjs"
  },
  "dependencies": {
    "@lenticule-science/metrologic": "0.3.0",
    "@red-cup-engineering/computer-data-engineering-services-section": "0.1.0",
    "@red-cup-engineering/computer-system-engine": "0.1.0",
    "@red-cup-engineering/json-services-section": "1.0.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
